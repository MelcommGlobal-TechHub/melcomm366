  <!-- =========================
       EVENT MODAL INTEGRATION
  ========================== -->
  <script>
    (() => {
      "use strict";

      const applyModal = document.getElementById("applyModal");
      const closeApplyModalButton = document.getElementById(
        "closeApplyModalButton"
      );
      const applyModalTitle = document.getElementById("applyModalTitle");
      const applyModalDescription = document.getElementById(
        "applyModalDescription"
      );
      const eventEyebrow = document.getElementById("eventEyebrow");
      const applyModalHighlights = document.getElementById(
        "applyModalHighlights"
      );
      const eventQualificationNote = document.getElementById(
        "eventQualificationNote"
      );
      const startLearningButton = document.getElementById(
        "startLearningButton"
      );

      if (
        !applyModal ||
        !closeApplyModalButton ||
        !applyModalTitle ||
        !applyModalDescription ||
        !applyModalHighlights ||
        !startLearningButton
      ) {
        return;
      }

      const programmeContent = {
        creathon: {
          eyebrow: "CREATIVE AI OPPORTUNITY",
          title: "Explore AI-powered creativity",
          description:
            "Discover how artificial intelligence can support African storytelling, filmmaking, music, design, and digital content creation.",
          highlights: [
            "Explore AI-powered storytelling and content creation.",
            "Learn how digital tools can support creative projects.",
            "Develop ideas that reflect African experiences and perspectives.",
            "Check official programme pages for current application details."
          ],
          qualification:
            "This is an educational introduction, not an official application portal. Check the programme organiser's official website for eligibility, deadlines, fees, and participation requirements.",
          button: "Explore creative lessons"
        },

        hackathon: {
          eyebrow: "AI INNOVATION OPPORTUNITY",
          title: "Build solutions with AI",
          description:
            "Learn how AI tools can help you explore ideas, create prototypes, and develop digital solutions to practical challenges.",
          highlights: [
            "Explore AI-assisted product development.",
            "Learn about prototyping and testing digital ideas.",
            "Identify practical problems that technology could help address.",
            "Review official competition rules before applying to an event."
          ],
          qualification:
            "This is an educational introduction, not a live application or a guarantee of selection. Confirm current dates, eligibility, and requirements with the official organiser.",
          button: "Explore AI lessons"
        }
      };

      let previousFocus = null;

      function renderHighlights(items) {
        applyModalHighlights.replaceChildren();

        items.forEach((item) => {
          const li = document.createElement("li");
          li.textContent = item;
          applyModalHighlights.appendChild(li);
        });
      }

      function openApplyModal(programme) {
        const content = programmeContent[programme];

        if (!content) {
          return;
        }

        previousFocus = document.activeElement;

        eventEyebrow.textContent = content.eyebrow;
        applyModalTitle.textContent = content.title;
        applyModalDescription.textContent = content.description;
        eventQualificationNote.textContent = content.qualification;

        renderHighlights(content.highlights);

        startLearningButton.textContent = content.button + " →";

        applyModal.hidden = false;
        document.body.classList.add("modal-open");

        closeApplyModalButton.focus();
      }

      function closeApplyModal() {
        applyModal.hidden = true;

        if (!document.querySelector(
          "#lessonPlayerModal:not([hidden]), #authModal:not([hidden])"
        )) {
          document.body.classList.remove("modal-open");
        }

        if (previousFocus && typeof previousFocus.focus === "function") {
          previousFocus.focus();
        }
      }

      function navigateToLearning() {
        closeApplyModal();

        const exploreButton = document.querySelector(
          '[data-view="explore"]'
        );

        if (exploreButton) {
          exploreButton.click();
        }
      }

      window.applyForEvent = openApplyModal;
      window.closeApplyModal = closeApplyModal;

      closeApplyModalButton.addEventListener("click", closeApplyModal);

      startLearningButton.addEventListener("click", navigateToLearning);

      applyModal.addEventListener("click", (event) => {
        if (event.target === applyModal) {
          closeApplyModal();
        }
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !applyModal.hidden) {
          closeApplyModal();
        }
      });
    })();
  </script>

  <!-- =========================
       SHARED MODAL BODY STATE
  ========================== -->
  <script>
    (() => {
      "use strict";

      const modalIds = [
        "applyModal",
        "authModal",
        "lessonPlayerModal"
      ];

      function updateModalBodyState() {
        const anyModalOpen = modalIds.some((id) => {
          const element = document.getElementById(id);
          return element && !element.hidden;
        });

        document.body.classList.toggle("modal-open", anyModalOpen);
      }

      modalIds.forEach((id) => {
        const modal = document.getElementById(id);

        if (!modal) {
          return;
        }

        const observer = new MutationObserver(updateModalBodyState);

        observer.observe(modal, {
          attributes: true,
          attributeFilter: ["hidden"]
        });
      });

      updateModalBodyState();

      const yearElement = document.getElementById("year");

      if (yearElement) {
        yearElement.textContent = new Date().getFullYear();
      }
    })();
  </script>

